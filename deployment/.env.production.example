APP_NAME=SchoolTry
APP_ENV=production
APP_KEY=<retrieve-from-ssm-securestring>
APP_DEBUG=false
APP_URL=https://schooltry.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=<rds-endpoint>
DB_PORT=3306
DB_DATABASE=schooltry
DB_USERNAME=<production-user>
DB_PASSWORD=<retrieve-from-ssm-securestring>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database

FILESYSTEM_DISK=s3
AWS_DEFAULT_REGION=eu-west-1
AWS_BUCKET=schooltry-assignment-uploads-2026-bjf
AWS_USE_PATH_STYLE_ENDPOINT=false

SANCTUM_EXPIRATION=480

MAIL_MAILER=log

VITE_APP_NAME=SchoolTry
